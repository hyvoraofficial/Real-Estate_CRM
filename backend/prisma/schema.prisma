generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_EXECUTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  REQUIREMENT_COLLECTED
  PROPERTY_SHARED
  SITE_VISIT
  NEGOTIATION
  BOOKED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CallDirection {
  INCOMING
  OUTGOING
}

enum FollowUpType {
  CALL
  WHATSAPP
  MEETING
  SITE_VISIT
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  INACTIVE
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(SALES_EXECUTIVE)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignedLeads     Lead[]
  assignedFollowUps FollowUp[]
  notes             Note[]

  @@map("users")
}

model Customer {
  id             String    @id @default(uuid())
  name           String
  phone          String    @unique
  alternatePhone String?
  whatsappNumber String?
  email          String?
  source         String    @default("Phone")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  leads      Lead[]
  callLogs   CallLog[]
  notesList  Note[]
  siteVisits SiteVisit[]
  bookings   Booking[]

  @@index([phone])
  @@index([name])
  @@map("customers")
}

model Lead {
  id             String       @id @default(uuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  status         LeadStatus   @default(NEW)
  priority       LeadPriority @default(MEDIUM)
  source         String       @default("Phone")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  requirement Requirement?
  followUps   FollowUp[]
  callLogs    CallLog[]
  notes       Note[]
  siteVisits  SiteVisit[]
  bookings    Booking[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([assignedUserId])
  @@map("leads")
}

model Requirement {
  id                   String   @id @default(uuid())
  leadId               String   @unique
  lead                 Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyType         String   @default("Apartment") // Apartment, Villa, Plot, Commercial, Office, Shop, Other
  bhk                  String?  // 1 BHK, 2 BHK, 3 BHK, 4 BHK, Plot, etc.
  preferredLocation    String
  minBudget            Float?
  maxBudget            Float?
  minArea              Float?
  maxArea              Float?
  purpose              String   @default("Buying") // Buying, Renting, Investment
  possessionPreference String?  // Ready to Move, Under Construction, Within 3 Months, Within 6 Months
  furnishingPreference String?  // Fully Furnished, Semi Furnished, Unfurnished
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([preferredLocation])
  @@index([propertyType])
  @@map("requirements")
}

model CallLog {
  id           String        @id @default(uuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  phoneNumber  String
  direction    CallDirection @default(INCOMING)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  duration     Int           @default(0) // duration in seconds
  notes        String?
  recordingUrl String?
  transcript   String?
  summary      String?
  createdAt    DateTime      @default(now())

  @@index([phoneNumber])
  @@index([customerId])
  @@index([leadId])
  @@index([createdAt])
  @@map("call_logs")
}

model Note {
  id         String    @id @default(uuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  content    String
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([leadId])
  @@map("notes")
}

model FollowUp {
  id             String         @id @default(uuid())
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?          @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  scheduledAt    DateTime
  type           FollowUpType   @default(CALL)
  status         FollowUpStatus @default(PENDING)
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())

  @@index([scheduledAt])
  @@index([status])
  @@index([assignedUserId])
  @@index([leadId])
  @@map("follow_ups")
}

model Property {
  id           String         @id @default(uuid())
  title        String
  propertyType String         @default("Apartment")
  bhk          String?
  location     String
  address      String?
  mapUrl       String?
  price        Float
  area         Float
  furnishing   String?
  possession   String?
  description  String?
  status       PropertyStatus @default(AVAILABLE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  images     PropertyImage[]
  siteVisits SiteVisit[]
  bookings   Booking[]

  @@index([location])
  @@index([status])
  @@index([propertyType])
  @@index([price])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  imageUrl   String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@map("property_images")
}

model SiteVisit {
  id          String          @id @default(uuid())
  leadId      String
  lead        Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status      SiteVisitStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([scheduledAt])
  @@index([status])
  @@index([leadId])
  @@index([customerId])
  @@index([propertyId])
  @@map("site_visits")
}

model Booking {
  id            String        @id @default(uuid())
  leadId        String
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookingAmount Float
  bookingDate   DateTime      @default(now())
  status        BookingStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([leadId])
  @@index([propertyId])
  @@index([status])
  @@map("bookings")
}
